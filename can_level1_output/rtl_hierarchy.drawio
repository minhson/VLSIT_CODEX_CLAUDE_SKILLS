          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r1" parent="i52__t" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" value="" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="2400" y="76" as="geometry" />
        </mxCell>
        <mxCell id="i52__r1__c0" parent="i52__r1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="TOP (can_top) frame" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="330" as="geometry">
            <mxRectangle height="80" width="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r1__c1" parent="i52__r1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="Top level of a CAN protocol controller for microcontroller-style hosts. It joins the host bus to an internal register file, a bit-timing generator and a frame-processing engine, and exposes the serial CAN receive and transmit lines, an interrupt output, a bus-off status output and a programmable clock output. In this configuration the host uses a multiplexed address/data bus with separate address-latch, read and write strobes and a chip-select input." vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="1480" x="330" as="geometry">
            <mxRectangle height="80" width="1480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r1__c2" parent="i52__r1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="can_top.v:214-874" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="230" x="1810" as="geometry">
            <mxRectangle height="80" width="230" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r1__c3" parent="i52__r1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="HOST, RX, TX, BOS, IRQ, CKO, CLK" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="360" x="2040" as="geometry">
            <mxRectangle height="80" width="360" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r2" parent="i52__t" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" value="" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="2400" y="156" as="geometry" />
        </mxCell>
        <mxCell id="i52__r2__c0" parent="i52__r2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="i_can_registers (can_registers)" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="330" as="geometry">
            <mxRectangle height="124" width="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r2__c1" parent="i52__r2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="Register file seen by the host. It stores the operating mode (basic or extended), command requests, interrupt enables, bit-timing parameters, the error-warning limit, the acceptance code and mask used for message filtering, a 13-byte transmit buffer and the clock-divider setting. It decodes host reads and writes and applies mode-dependent access rules (many registers can be written only while the controller is in reset mode), builds the status word from the reports of the frame-processing engine, collects seven interrupt sources into one latched, read-to-clear, active-low interrupt request, selects the register value returned on a read, and derives a programmable divided output clock. Its own logic is not expanded at this level." vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="1480" x="330" as="geometry">
            <mxRectangle height="124" width="1480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r2__c2" parent="i52__r2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="can_registers.v:444-1251" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="230" x="1810" as="geometry">
            <mxRectangle height="124" width="230" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r2__c3" parent="i52__r2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="HRA, RRD, CSI, BTI, IRQ, CLK, CKO" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="360" x="2040" as="geometry">
            <mxRectangle height="124" width="360" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r3" parent="i52__t" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" value="" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="2400" y="280" as="geometry" />
        </mxCell>
        <mxCell id="i52__r3__c0" parent="i52__r3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="i_can_btl (can_btl)" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="330" as="geometry">
            <mxRectangle height="124" width="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r3__c1" parent="i52__r3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="Bit-timing generator. It derives the time quantum from the programmed prescaler, divides every bit into a synchronization segment, a first phase segment (including the propagation segment) and a second phase segment, performs hard synchronization on the start-of-frame edge and resynchronization on later edges within the programmed jump width, and can take three samples per bit and apply a majority vote. It produces the sample instant used by the receiver and the transmit instant used to drive the bus, and restricts synchronization while the node is transmitting. Its own logic is not expanded at this level." vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="1480" x="330" as="geometry">
            <mxRectangle height="124" width="1480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r3__c2" parent="i52__r3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="can_btl.v:257-445" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="230" x="1810" as="geometry">
            <mxRectangle height="124" width="230" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r3__c3" parent="i52__r3" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="BTI, BSI, RXS, CLK" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="360" x="2040" as="geometry">
            <mxRectangle height="124" width="360" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r4" parent="i52__t" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" value="" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="2400" y="404" as="geometry" />
        </mxCell>
        <mxCell id="i52__r4__c0" parent="i52__r4" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="i_can_bsp (can_bsp)" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="330" as="geometry">
            <mxRectangle height="124" width="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r4__c1" parent="i52__r4" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="Frame-processing engine. On reception it decodes identifier, control, data, CRC, acknowledge and end-of-frame fields with bit de-stuffing and CRC checking, filters accepted identifiers with an acceptance filter and stores accepted messages in a receive FIFO. On transmission it serializes the transmit buffer with bit stuffing, arbitrates against other nodes and handles the acknowledge slot. It detects bit, stuff, form, CRC and acknowledge errors, generates error and overload frames, and maintains transmit and receive error counters with the error-active, error-passive and bus-off states. It reports status, errors and events to the register file. Its own logic and children (CRC, acceptance filter, FIFO) are not expanded at this level." vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="1480" x="330" as="geometry">
            <mxRectangle height="124" width="1480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r4__c2" parent="i52__r4" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="can_bsp.v:699-2127" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="230" x="1810" as="geometry">
            <mxRectangle height="124" width="230" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r4__c3" parent="i52__r4" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="FAC, FRI, CSI, BSI, CLK, BOS, TX" vertex="1" vlsit_native_table="1">
          <mxGeometry height="124" width="360" x="2040" as="geometry">
            <mxRectangle height="124" width="360" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r5" parent="i52__t" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" value="" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="2400" y="528" as="geometry" />
        </mxCell>
        <mxCell id="i52__r5__c0" parent="i52__r5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="Host bus adapter (FG of can_top)" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="330" as="geometry">
            <mxRectangle height="80" width="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r5__c1" parent="i52__r5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="Converts the multiplexed host bus into single-clock accesses. It captures the address presented on the shared lines while the address-latch strobe is active, detects the active edge of the write or read strobe to form one access pulse qualified by the chip-select input, passes the latched address and write data to the register file and the receive FIFO, and drives the read data onto the shared data lines only while a read is requested." vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="1480" x="330" as="geometry">
            <mxRectangle height="80" width="1480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r5__c2" parent="i52__r5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="can_top.v:836-869" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="230" x="1810" as="geometry">
            <mxRectangle height="80" width="230" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r5__c3" parent="i52__r5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="HRA, HRS, FAC, HOST, CLK" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="360" x="2040" as="geometry">
            <mxRectangle height="80" width="360" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r6" parent="i52__t" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" value="" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="2400" y="608" as="geometry" />
        </mxCell>
        <mxCell id="i52__r6__c0" parent="i52__r6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="Read-data select (FG of can_top)" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="330" as="geometry">
            <mxRectangle height="80" width="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r6__c1" parent="i52__r6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="Read-path multiplexer. From the latched address and the operating mode it decides whether a host read targets the received-message window or an ordinary register, selects the corresponding data source, and keeps the selected byte in an output register so that the host sees stable data until the next read." vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="1480" x="330" as="geometry">
            <mxRectangle height="80" width="1480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r6__c2" parent="i52__r6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="can_top.v:743-762" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="230" x="1810" as="geometry">
            <mxRectangle height="80" width="230" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r6__c3" parent="i52__r6" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="HRS, RRD, FRI, CLK" vertex="1" vlsit_native_table="1">
          <mxGeometry height="80" width="360" x="2040" as="geometry">
            <mxRectangle height="80" width="360" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r7" parent="i52__t" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;strokeColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontSize=18;fontColor=#000000;" value="" vertex="1" vlsit_native_table="1">
          <mxGeometry height="58" width="2400" y="688" as="geometry" />
        </mxCell>
        <mxCell id="i52__r7__c0" parent="i52__r7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="RX synchronizer (FG of can_top)" vertex="1" vlsit_native_table="1">
          <mxGeometry height="58" width="330" as="geometry">
            <mxRectangle height="58" width="330" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r7__c1" parent="i52__r7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="Receive-line synchronizer. It passes the asynchronous CAN receive input through two flip-flops clocked by the core clock to remove metastability before the bit-timing generator uses it, and is initialised to the recessive (idle) level during reset." vertex="1" vlsit_native_table="1">
          <mxGeometry height="58" width="1480" x="330" as="geometry">
            <mxRectangle height="58" width="1480" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r7__c2" parent="i52__r7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="can_top.v:766-778" vertex="1" vlsit_native_table="1">
          <mxGeometry height="58" width="230" x="1810" as="geometry">
            <mxRectangle height="58" width="230" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i52__r7__c3" parent="i52__r7" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontColor=#000000;" value="RXS, RX, CLK" vertex="1" vlsit_native_table="1">
          <mxGeometry height="58" width="360" x="2040" as="geometry">
            <mxRectangle height="58" width="360" as="alternateBounds" />
