        <mxCell id="i52__r0__c3" parent="i52__r0" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;fillColor=none;strokeColor=#000000;strokeWidth=1;overflow=hidden;pointerEvents=1;align=left;verticalAlign=middle;spacing=4;fontStyle=1;fontSize=18;fontColor=#000000;" value="Interfaces (mnemonics)" vertex="1" vlsit_native_table="1">
          <mxGeometry height="36" width="360" x="2040" as="geometry">
